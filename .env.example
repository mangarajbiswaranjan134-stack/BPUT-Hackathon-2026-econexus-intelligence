# EcoNexus Intelligence - Environment Configuration
# Copy this file to .env and fill in your API keys
# All keys are OPTIONAL - the app works in demo mode without them

# === AI Integration ===
# Gemini API key for AI copilot, insights, and recommendations
GEMINI_API_KEY=

# === Maps Integration ===
# MapTiler, Mapbox, or Google Maps API key
MAP_API_KEY=
MAP_PROVIDER=openstreetmap

# === Weather Integration ===
# OpenWeather or WeatherAPI key
WEATHER_API_KEY=
WEATHER_PROVIDER=openweather

# === Geocoding ===
GEOCODING_API_KEY=

# === Database ===
DATABASE_URL=sqlite:///./econexus.db

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true
FRONTEND_URL=http://localhost:5173
